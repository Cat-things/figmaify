{
  "name": "figmaify",
  "productName": "Figmaify",
  "version": "0.1.0",
  "description": "Turn Figma designs into Windows desktop apps",
  "main": "src/main/index.js",
  "author": "Cat-things",
  "license": "MIT",
  "homepage": "https://github.com/Cat-things/figmaify",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cat-things/figmaify.git"
  },
  "bugs": {
    "url": "https://github.com/Cat-things/figmaify/issues"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"test/*.test.js\"",
    "typecheck": "tsc -p jsconfig.json",
    "icons": "node scripts/make-icons.js",
    "dist": "electron-builder --win --publish never",
    "dist:dir": "electron-builder --win --dir --publish never"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "rcedit": "^5.0.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "figma",
    "electron",
    "desktop",
    "windows",
    "converter"
  ]
}
